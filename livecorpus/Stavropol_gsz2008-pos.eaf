    <TIER ANNOTATOR="@gsz2008m" LINGUISTIC_TYPE_REF="utterance"
        PARTICIPANT="@gsz2008m" TIER_ID="text@gsz2008m">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>ну / если задача потратить за год</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>можно / положить их / на одиннадцать месяцев / на накопительный счёт / в банке</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5"
                TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>чтобы за одиннадцать месяцев там накапали проценты</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>ну в сравнении / с ээ одиннадцатью / с= с десятью / м= миллионами долларов это / будут не такие уж роскошные проценты</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>но всё равно ведь деньги / вот</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>и потом / в течение двеннадцатого месяца пытаться их тратить</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>ммм / будет довольно сложно столько денег потратить за / двеннадцать месяцев</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56"
                TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>но наверное получится что-нибудь придумать</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a641"
                TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>друзей знакомых у меня много</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599"
                TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>всегда кому-то можно / там / я не знаю / лишнюю квартиру ку=</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58"
                TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>ну хотя дес= / не / десять миллионов это / не настолько абсурдно большие деньги</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a638"
                TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>особенно если про недвижимость говорить</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59"
                TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>ээ / там / я не знаю</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60"
                TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>парочка хороших / квартир в Москве / наверное / ээ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61"
                TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE> ну м= в= вот можно / купить / парочку / квартир в Москве / и / использовать их как активы / и / потом когда-нибудь обналичить</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62"
                TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>мне кажется это хороший выход из ситуации</ANNOTATION_VALUE>
